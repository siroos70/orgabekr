# Inject ZARINPAL_MERCHANT_ID through the protected Webdev secret flow; never commit its value.
ZARINPAL_MODE=sandbox
# Required for every internet-exposed deployment; exact browser-visible HTTPS origin, no path.
PUBLIC_ORIGIN=https://example.ir
# Managed Webdev database supplies DATABASE_URL automatically when database is enabled.
# Keep TLS verification enabled in production; only set false for a documented local fallback.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
